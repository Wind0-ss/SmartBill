# ============================================================
# SmartBill — Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Environment: development | production
APP_ENV=production

# Your domain URL (no trailing slash)
# Example: https://smartbill.yourdomain.com
APP_URL=https://your-domain.com

# Database Configuration (from cPanel → MySQL Databases)
DB_HOST=localhost
DB_NAME=your_cpanel_user_smartbill
DB_USER=your_cpanel_user_dbuser
DB_PASS=your_strong_password_here
